diff --git a/sam3d_objects/pipeline/inference_pipeline.py b/sam3d_objects/pipeline/inference_pipeline.py
index 312e3c6..ec0bc55 100644
--- a/sam3d_objects/pipeline/inference_pipeline.py
+++ b/sam3d_objects/pipeline/inference_pipeline.py
@@ -581,7 +581,23 @@ class InferencePipeline:
             if mask.ndim == 2:
                 mask = mask[..., None]
 
-            logger.info(f"Replacing alpha channel with the provided mask")
+            # load_image_and_mask_from_rgba returns `alpha > 0`, i.e. a BOOLEAN
+            # mask. Concatenating that straight into an 8-bit alpha channel
+            # writes 0/1 instead of 0/255; the pipeline later divides alpha by
+            # 255, so the mask arrives as 0.0039 and every `> 0.5` test fails.
+            # The mask then selects zero pixels, and normalisation silently
+            # falls back to a default scale - which yields a mesh at the wrong
+            # size rather than an error.
+            if mask.dtype == bool:
+                mask = mask.astype(np.uint8) * 255
+            elif np.issubdtype(mask.dtype, np.floating):
+                mask = (mask > 0.5).astype(np.uint8) * 255
+            elif mask.max() <= 1:
+                mask = mask.astype(np.uint8) * 255
+            mask = mask.astype(image.dtype)
+
+            logger.info(f"Replacing alpha channel with the provided mask "
+                        f"(dtype={mask.dtype}, max={int(mask.max())})")
             assert mask.shape[:2] == image.shape[:2]
             image = np.concatenate([image[..., :3], mask], axis=-1)
 
