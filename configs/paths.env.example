# Where the external pieces live on THIS machine. Copy to configs/paths.env and
# edit; every script reads these instead of hardcoding a path.
#
#     cp configs/paths.env.example configs/paths.env
#     $EDITOR configs/paths.env
#     source configs/paths.env
#
# Anything already exported in your shell wins, so you can override one value
# without editing the file.

# --- the two python environments (see README > Install) ---------------------
export RS_PY_SIM="${RS_PY_SIM:-/mnt/ssd2/conda/envs/robosnap-sim/bin/python}"
export RS_PY_ASSET="${RS_PY_ASSET:-/mnt/ssd2/conda/envs/robosnap-asset/bin/python}"
export RS_PY_LYRA="${RS_PY_LYRA:-/mnt/ssd2/conda/envs/robosnap-lyra/bin/python}"
export RS_PY_SAM3="${RS_PY_SAM3:-/mnt/ssd2/conda/envs/robosnap-sam3/bin/python}"

# --- whole-body controller policies ----------------------------------------
# The two ONNX nets. Only needed for the bundled in-process controller
# (scripts/realsim/run_wbc.py); a deployed controller ships its own.
export RS_WBC_MODELS="${RS_WBC_MODELS:-/mnt/ssd2/simple_wbc_code/models}"

# --- the deployed control stack, if you have one ----------------------------
# Provides the DDS bridge (gear_sonic + unitree_sdk2py) and the WBC container.
export RS_DEPLOY_ROOT="${RS_DEPLOY_ROOT:-/mnt/ssd2/vla_for_simulation_testing}"
export RS_PY_DDS="${RS_PY_DDS:-$RS_DEPLOY_ROOT/.venv_sim/bin/python}"

# --- VLA policy server, if you want a policy on the arms --------------------
export RS_GROOT_ROOT="${RS_GROOT_ROOT:-/mnt/ssd2/Isaac-GR00T}"
export RS_GROOT_PY="${RS_GROOT_PY:-/mnt/ssd2/dsrl/.venv/bin/python}"
export RS_GROOT_CHECKPOINT="${RS_GROOT_CHECKPOINT:-$RS_GROOT_ROOT/checkpoints/my_checkpoint}"
export RS_GROOT_EMBODIMENT="${RS_GROOT_EMBODIMENT:-unitree_g1_full_body_with_waist_height_nav_cmd}"

# --- OpenMVS, only for the optional room-mesh path -------------------------
export RS_OPENMVS_BIN="${RS_OPENMVS_BIN:-/mnt/ssd2/Re3Sim/third_party/openmvs-install/bin/OpenMVS}"

# --- display / GPU ---------------------------------------------------------
export DISPLAY="${DISPLAY:-:1}"
# Hard ceiling in MiB. start.sh refuses to launch if it would be crossed, which
# matters on a shared card.
export RS_VRAM_CEILING_MIB="${RS_VRAM_CEILING_MIB:-31000}"
