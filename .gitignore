# --- generated scenes and model weights: never commit these -----------------
# A single scene directory runs 5-60 GB (splats, dense COLMAP, depth maps) and
# the checkpoint set is ~134 GB. Both are reproducible from the pipeline.
outputs/
checkpoints/
*.ply
*.glb
*.npz
*.mp4
*.pt
*.pth
*.onnx
*.safetensors

# --- secrets ---------------------------------------------------------------
.env
configs/auto_pipeline.env
configs/gui.env
*.key

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# --- editors / os ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
*.swp

# --- local working artefacts ----------------------------------------------
*.log
*.bak
*.pre_*
*.orig
MUJOCO_LOG.TXT

*.bak_*
*.prelight_*

# machine-specific paths
configs/paths.env

# robot models belong to their manufacturers - keep them local
# (scripts/fetch_g1_meshes.sh puts the G1 ones in place). The camera-rig parts
# under meshes/cad/ are our own CAD and ship with the repo.
assets/robots/*/meshes/*
!assets/robots/g1/meshes/cad/
assets/robots/*/*.STL
assets/robots/*/*.stl
assets/robots/*/*.dae
assets/robots/*/*.obj

inputs/

# --- prebuilt scenes shipped with the repo (Git LFS, see .gitattributes) ----
!scenes/**/*.ply

# per-session logs the sim writes next to a scene (run_mujoco_wbc_sim.py)
scenes/*/episode_layouts/
