+#!/usr/bin/env python3
+"""Standalone robot camera viewer.
+
+Connects to a robot_camera_server ZMQ PUB socket, shows each camera's stream
+in its own window, and prints per-camera receive FPS to the terminal so you
+can track how fast frames are actually arriving.
+
+Only needs: pyzmq, opencv-python, numpy
+    pip install pyzmq opencv-python numpy
+
+Usage:
+    python3 camera_client.py --host <robot-ip> --port 5555
+    python3 camera_client.py --host localhost --port 5555 --topics ego_view ego_left
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import threading
+import time
+
+import cv2
+import numpy as np
+import zmq
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description="Robot camera ZMQ viewer")
+    parser.add_argument("--host", default="localhost", help="Camera server host")
+    parser.add_argument("--port", type=int, default=5555, help="Camera server ZMQ port")
+    parser.add_argument(
+        "--topics", nargs="*", default=None,
+        help="Camera names to subscribe to (default: all cameras published by the server)",
+    )
+    parser.add_argument(
+        "--fps-interval", type=float, default=1.0,
+        help="Seconds between FPS reports per camera (default: 1.0)",
+    )
+    parser.add_argument(
+        "--no-display", action="store_true",
+        help="Only print FPS stats, don't open image windows",
+    )
+    return parser.parse_args()
+
+
+class FpsTracker:
+    def __init__(self, report_interval: float):
+        self.report_interval = report_interval
+        self.count = 0
+        self.window_start = time.time()
+        self.fps = 0.0
+
+    def tick(self) -> float | None:
+        """Register one received frame. Returns the FPS value if it just refreshed."""
+        self.count += 1
+        now = time.time()
+        elapsed = now - self.window_start
+        if elapsed >= self.report_interval:
+            self.fps = self.count / elapsed
+            self.count = 0
+            self.window_start = now
+            return self.fps
+        return None
+
+
+# The real robot's camera server publishes ego_view / ego_left / ego_right; the
+# real2sim2real camera server (scripts/realsim/vla_camera_server.py) publishes
+# the same frames as stereo/right / hand_left / hand_right. Both names are
+# subscribed and stored under the robot's, so one client works against either.
+TOPIC_ALIASES = {"stereo/right": "ego_view", "hand_left": "ego_left", "hand_right": "ego_right"}
+
+
+class CameraClient:
+    """Background ZMQ SUB client keeping only the newest frame per camera.
+
+    Drop-in for VLAImageClient: ``read()`` returns ``{"images": {name: RGB HxWx3
+    uint8}, "timestamps": {name: float}}`` once every camera in ``topics`` has
+    delivered a frame, else None. Frames are decoded lazily in read().
+    """
+
+    def __init__(self, host: str, port: int, topics: list[str]):
+        self.topics = list(topics)
+        self._ctx = zmq.Context()
+        self._sock = self._ctx.socket(zmq.SUB)
+        self._sock.setsockopt(zmq.RCVHWM, 10)
+        self._sock.setsockopt(zmq.RCVTIMEO, 200)
+        self._sock.connect(f"tcp://{host}:{port}")
+        for t in self.topics:
+            self._sock.setsockopt_string(zmq.SUBSCRIBE, t)
+        for alias, name in TOPIC_ALIASES.items():
+            if name in self.topics:
+                self._sock.setsockopt_string(zmq.SUBSCRIBE, alias)
+        self._latest: dict[str, tuple[bytes, float]] = {}
+        self._lock = threading.Lock()
+        self._running = True
+        self._thread = threading.Thread(target=self._recv_loop, daemon=True)
+        self._thread.start()
+
+    def _recv_loop(self):
+        while self._running:
+            try:
+                topic, header_bytes, payload = self._sock.recv_multipart()
+            except zmq.Again:
+                continue
+            except zmq.ZMQError:
+                break
+            header = json.loads(header_bytes.decode("utf-8"))
+            with self._lock:
+                name = topic.decode("utf-8")
+                self._latest[TOPIC_ALIASES.get(name, name)] = (payload, header.get("timestamp", 0.0))
+
+    def missing_topics(self) -> list[str]:
+        """Topics in ``self.topics`` that have not delivered a frame yet."""
+        with self._lock:
+            return [t for t in self.topics if t not in self._latest]
+
+    def read(self):
+        with self._lock:
+            if any(t not in self._latest for t in self.topics):
+                return None
+            snap = dict(self._latest)
+        images, stamps = {}, {}
+        for t in self.topics:
+            payload, ts = snap[t]
+            bgr = cv2.imdecode(np.frombuffer(payload, dtype=np.uint8), cv2.IMREAD_COLOR)
+            if bgr is None:
+                return None
+            images[t] = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)
+            stamps[t] = ts
+        return {"images": images, "timestamps": stamps}
+
+    def close(self):
+        self._running = False
+        self._thread.join(timeout=1.0)
+        self._sock.close(linger=0)
+        self._ctx.term()
+
+
+def main():
+    args = parse_args()
+
+    context = zmq.Context.instance()
+    socket = context.socket(zmq.SUB)
+    socket.setsockopt(zmq.RCVHWM, 10)
+    addr = f"tcp://{args.host}:{args.port}"
+    socket.connect(addr)
+
+    if args.topics:
+        for topic in args.topics:
+            socket.setsockopt_string(zmq.SUBSCRIBE, topic)
+    else:
+        socket.setsockopt_string(zmq.SUBSCRIBE, "")  # all topics
+
+    print(f"Connected to {addr}")
+    print(f"Subscribed to: {', '.join(args.topics) if args.topics else 'ALL cameras'}")
+    print("Press 'q' in an image window, or Ctrl+C here, to quit.\n")
+
+    trackers: dict[str, FpsTracker] = {}
+
+    try:
+        while True:
+            topic, header_bytes, payload = socket.recv_multipart()
+            name = topic.decode("utf-8")
+            header = json.loads(header_bytes.decode("utf-8"))
+
+            tracker = trackers.setdefault(name, FpsTracker(args.fps_interval))
+            fps = tracker.tick()
+            if fps is not None:
+                latency_ms = (time.time() - header["timestamp"]) * 1000
+                print(f"[{name}] recv_fps={fps:5.1f}  latency={latency_ms:6.1f}ms  seq={header['seq']}")
+
+            if not args.no_display:
+                frame = cv2.imdecode(np.frombuffer(payload, dtype=np.uint8), cv2.IMREAD_COLOR)
+                if frame is not None:
+                    cv2.putText(
+                        frame, f"{name}  {tracker.fps:.1f} fps", (10, 24),
+                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2,
+                    )
+                    cv2.imshow(name, frame)
+                    if cv2.waitKey(1) & 0xFF == ord("q"):
+                        break
+    except KeyboardInterrupt:
+        pass
+    finally:
+        cv2.destroyAllWindows()
+        socket.close(linger=0)
+        context.term()
+
+
+if __name__ == "__main__":
+    main()
