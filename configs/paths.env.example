# Where the external pieces live on THIS machine. Copy to configs/paths.env and
# edit; every script reads these instead of hardcoding a path.
#
#     cp configs/paths.env.example configs/paths.env
#     $EDITOR configs/paths.env
#     source configs/paths.env
#
# Anything already exported in your shell wins, so you can override one value
# without editing the file.

# --- the four python environments (see README > Install) --------------------
export RS_PY_SIM="${RS_PY_SIM:-$HOME/miniconda3/envs/robosnap-sim/bin/python}"
export RS_PY_ASSET="${RS_PY_ASSET:-$HOME/miniconda3/envs/robosnap-asset/bin/python}"
export RS_PY_LYRA="${RS_PY_LYRA:-$HOME/miniconda3/envs/robosnap-lyra/bin/python}"
export RS_PY_SAM3="${RS_PY_SAM3:-$HOME/miniconda3/envs/robosnap-sam3/bin/python}"

# --- NVIDIA GR00T-WholeBodyControl (scripts/setup_external.sh) --------------
# The deployed whole-body controller, Pico teleop, LeRobot exporter and the
# DDS bridge (gear_sonic + unitree_sdk2py) the simulator runs on.
export RS_DEPLOY_ROOT="${RS_DEPLOY_ROOT:-$RS_ROOT/external/GR00T-WholeBodyControl}"
export RS_PY_DDS="${RS_PY_DDS:-$RS_DEPLOY_ROOT/.venv_sim/bin/python}"
# The two balance/walk ONNX policies, for the in-process controller
# (start.sh --builtin). Same files the deployed controller loads.
export RS_WBC_MODELS="${RS_WBC_MODELS:-$RS_DEPLOY_ROOT/decoupled_wbc/sim2mujoco/resources/robots/g1/policy}"

# --- the real robot's camera server (calibration only) ---------------------
# 192.168.123.164 is the G1's onboard computer on Unitree's default network.
export RS_ROBOT_CAMERA="${RS_ROBOT_CAMERA:-tcp://192.168.123.164:5555}"

# --- display / GPU ---------------------------------------------------------
export DISPLAY="${DISPLAY:-:0}"
# Hard ceiling in MiB. start.sh refuses to launch if it would be crossed, which
# matters on a shared card.
export RS_VRAM_CEILING_MIB="${RS_VRAM_CEILING_MIB:-31000}"
